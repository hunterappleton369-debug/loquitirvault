# RetellAI API Key — Get from https://dashboard.retellai.com/apiKey
RETELL_API_KEY=your_retell_api_key_here

# Cal.com Configuration — Get from https://app.cal.com/settings/developer/api-keys
CALCOM_API_KEY=your_calcom_api_key_here
CALCOM_EVENT_TYPE_ID=your_event_type_id_here
CALCOM_USERNAME=your_calcom_username_here
